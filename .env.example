# Copy to .env.local. These are SERVER-ONLY secrets: never use NEXT_PUBLIC_.

# Notion — use an internal integration with read, insert and update capabilities.
NOTION_API_KEY=
# Parent page shared with the integration. Used only by npm run notion:setup.
NOTION_PARENT_PAGE_ID=
# The 2025-09-03 API uses data source IDs, NOT database/container IDs.
NOTION_EVENTS_DATA_SOURCE_ID=
NOTION_TASKS_DATA_SOURCE_ID=
NOTION_RESOURCES_DATA_SOURCE_ID=
NOTION_PEOPLE_DATA_SOURCE_ID=

# Optional persistent storage for serverless deployment. Run docs/supabase.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI provider; Gemini takes precedence if both are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional local file location (default: <project>/data/state.json).
# EVENTOS_DATA_FILE=
